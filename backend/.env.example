# ---------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your values.
# NEVER commit the real .env file. It is ignored by Git.
# ---------------------------------------------------------------

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (ask the team leader for the real one).
# Format: mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# If the password contains symbols, URL-encode them (for example @ becomes %40).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/ousl_short_courses?retryWrites=true&w=majority

# Long random string used to sign login tokens (at least 32 characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE
JWT_EXPIRES_IN=7d

# Frontend address(es) allowed to call the API (comma separated).
CLIENT_URL=http://localhost:5173

# DEMO ONLY: the forgot-password endpoint also returns the reset token in its
# response so the demo reset page works without an email service.
# It is ignored (always off) when NODE_ENV=production.
DEV_RESET_TOKEN_IN_RESPONSE=true

# ---------------------------------------------------------------
# Accounts created by "npm run seed". Choose your own passwords
# (at least 8 characters). Only ONE team member runs the seed.
#
# Roles: superadmin (can do everything), admin (cannot add admins),
#        instructor (edits content of assigned courses), student.
# ---------------------------------------------------------------

# Required: the only super admin account. It cannot be created from the website.
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=change-me-superadmin

# Optional demo accounts (leave out any you do not want)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
SEED_INSTRUCTOR_EMAIL=instructor@example.com
SEED_INSTRUCTOR_PASSWORD=change-me-instructor
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=change-me-student
